  <system.webServer>

   <httpProtocol>
  <customHeaders>
    <remove name="X-Powered-By"/>
    <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains"/>
    <add name="Access-Control-Allow-Origin" value="https://pmsvapt.educategirls.ngo"/>
    <add name="Access-Control-Allow-Credentials" value="true"/>
    <add name="Access-Control-Allow-Headers" value="Content-Type"/>
    <add name="Access-Control-Allow-Methods" value="GET,POST"/>
    <add name="X-Frame-Options" value="SAMEORIGIN"/>
    <add name="X-Content-Type-Options" value="nosniff"/>
    <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
    <add name="X-Xss-Protection" value="1; mode=block"/>
    <add name="Pragma" value="no-cache"/>
    <add name="Cache-control" value="private, no-store, pre-check=0"/>

    <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://geo1server.educategirls.ngo https://server.arcgisonline.com https://*.arcgisonline.com https://*.arcgis.com https://api.mapbox.com https://*.tiles.mapbox.com https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com https://*.ggpht.com; connect-src 'self' https://geo1server.educategirls.ngo https://server.arcgisonline.com https://*.arcgisonline.com https://*.arcgis.com https://api.mapbox.com https://*.tiles.mapbox.com https://*.googleapis.com https://*.google.com https://*.gstatic.com data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; frame-src https://*.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';" />
  </customHeaders>
</httpProtocol>
   
    <handlers>
      <add name="ReportViewerWebControlHandler" preCondition="integratedMode" verb="*" path="Reserved.ReportViewerWebControl.axd" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a"/>
    </handlers>
    <modules runAllManagedModulesForAllRequests="true"/>
    <validation validateIntegratedModeConfiguration="false"/>
    <defaultDocument>
